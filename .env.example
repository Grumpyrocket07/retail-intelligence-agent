# Copy this file to .env and fill in your values. Never commit .env.
DB_HOST=127.0.0.1
# Your local MySQL ran on 3307 in the ETL project; change if yours differs.
DB_PORT=3307
DB_NAME=retail_agent

# Read/write user, used only by the ETL scripts
DB_USER=retail_user
DB_PASSWORD=change_me

# Read-only user, used for AI-written SQL (create it with sql/01_create_readonly_user.sql)
DB_RO_USER=retail_ro
DB_RO_PASSWORD=change_me_too

# Free key from https://aistudio.google.com/apikey  (keep it secret)
GEMINI_API_KEY=paste_your_key_here
# Optional: GEMINI_MODEL=gemini-3.8-flash
# Optional tuning
# SQL_TIMEOUT_SECONDS=30          longest a query may run
# LLM_TIMEOUT_SECONDS=60          give up on one AI call after this long
# GEMINI_REASONING_EFFORT=low     minimal | low | medium | high: lower is faster
